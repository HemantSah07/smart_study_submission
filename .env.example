# ============================================================
#  Smart Study — Environment Configuration Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit your actual .env file to version control.
# ============================================================

# ----- Flask Core -----
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=False

# ----- Database -----
# Use 'sqlite' for local development or 'mysql' for production
DB_TYPE=sqlite

# MySQL configuration (only needed when DB_TYPE=mysql)
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_NAME=smart_study

# ----- Session Cookie Security -----
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax

# ----- AI / Gemini API -----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_MCQ=gemini-3.1-flash-lite
GEMINI_MODEL_ASSISTANT_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_ASSISTANT_FALLBACK=gemini-2.5-flash-lite
GEMINI_BILLING_ENABLED=False

# Gemini daily usage limits (optional — adjust for your quota tier)
GEMINI_DAILY_LIMIT_MCQ=450
GEMINI_RPM_LIMIT_MCQ=10
GEMINI_DAILY_LIMIT_ASSISTANT_PRIMARY=45
GEMINI_DAILY_LIMIT_ASSISTANT_FALLBACK=45
GEMINI_RPM_LIMIT_ASSISTANT_PRIMARY=4

# ----- Anthropic (optional AI fallback) -----
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ----- Abstract API (email validation) -----
ABSTRACT_API_KEY=your-abstract-api-key-here

# ----- Flask-Mail (SMTP) -----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-app-password-here
